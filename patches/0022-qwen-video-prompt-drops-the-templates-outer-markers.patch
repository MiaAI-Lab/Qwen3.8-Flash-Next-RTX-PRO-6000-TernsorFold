+/// Whether `ids[src]` is one of the markers a Qwen template writes around its video token. The processor the checkpoint was made with
+/// replaces the three tokens with the video's groups, each already between its own markers, so the outer pair never reaches the model.
+fn outerVideoMark(v: api.Vision, ids: []const u32, src: usize) bool {
+    const o = v.video orelse return false;
+    if (o.time_first == null) return false;
+    if (ids[src] == o.group_open) return src + 1 < ids.len and ids[src + 1] == o.video_token;
+    if (ids[src] == o.group_close) return src > 0 and ids[src - 1] == o.video_token;
+    return false;
+}
