+test "the markers a Qwen template writes around its video token are told from every other marker" {
+    var dummy: u8 = 0;
+    const open: u32 = 6;
+    const shut: u32 = 7;
+    const offer: api.VideoOffer = .{ .prepare = fakeVideo, .video_token = 8, .group_open = open, .group_close = shut, .time_first = 8, .video_tokens = 64, .max_videos = 2, .max_frames = 256 };
+    const v: api.Vision = .{ .ctx = &dummy, .prepare = fakePrepare, .image_token = 9, .image_tokens = 64, .max_images = 4, .video = offer };
+    try std.testing.expect(outerVideoMark(v, &[_]u32{ 1, open, 8, shut }, 1));
+    try std.testing.expect(outerVideoMark(v, &[_]u32{ 1, open, 8, shut }, 3));
+    // an image's markers, and markers away from a video token, stay
+    try std.testing.expect(!outerVideoMark(v, &[_]u32{ open, 9, shut, open, 8, shut }, 0));
+    try std.testing.expect(!outerVideoMark(v, &[_]u32{ open, 9, shut, open, 8, shut }, 2));
+    // a family whose template writes no such pair keeps every marker
+    var plain = v;
+    plain.video.?.time_first = null;
+    try std.testing.expect(!outerVideoMark(plain, &[_]u32{ 1, open, 8, shut }, 1));
+}
