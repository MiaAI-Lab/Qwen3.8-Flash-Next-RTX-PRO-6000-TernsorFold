diff --git a/zig/src/families/flashnext/cuda_rotary.zig b/zig/src/families/flashnext/cuda_rotary.zig
new file mode 100644
index 0000000..b13752b
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_rotary.zig
@@ -0,0 +1,62 @@
+//! RoPE's table for one load, as flashnext_attn.cu's rope reads it: the 32 frequencies, then cos and sin's scale.
+//! Up to the trained window it is the plain rotary at scale 1. A --context past it (patch 0025) takes static YaRN x4 for every prompt,
+//! transformers' _compute_yarn_parameters as the Metal engine has it (rotary_config.zig): the low frequencies a quarter, beta 32 and 1,
+//! cos and sin times 0.1 ln 4 + 1. Attention, the indexer's queries and pooled keys, images' M-RoPE and the MTP head all read this table.
+const std = @import("std");
+const wt = @import("cuda_prompt_wt.zig");
+const config = @import("rotary_config.zig");
+
+const half = wt.half;
+pub const words = half + 1;
+pub const bytes = words * @sizeOf(f32);
+const base: f64 = 10_000_000.0;
+
+pub fn table(yarn: bool) [words]f32 {
+    var out: [words]f32 = undefined;
+    if (yarn) {
+        const y = config.yarn(base, @floatFromInt(wt.yarn_factor), wt.window);
+        @memcpy(out[0..half], &y.freq);
+        out[half] = y.scale;
+    } else {
+        for (out[0..half], 0..) |*o, i| o.* = @floatCast(std.math.pow(f64, base, -@as(f64, @floatFromInt(i)) / @as(f64, half)));
+        out[half] = 1;
+    }
+    return out;
+}
+
+test "up to the trained window: the plain frequencies, scale exactly 1" {
+    const t = table(false);
+    for (t[0..half], 0..) |v, i| try std.testing.expectEqual(@as(f32, @floatCast(std.math.pow(f64, 10_000_000.0, -@as(f64, @floatFromInt(i)) / 32.0))), v);
+    try std.testing.expectEqual(@as(f32, 1), t[half]);
+    try std.testing.expectEqual(@as(usize, 132), bytes);
+}
+
+test "past it: transformers' YaRN x4 table for base 1e7 over 262,144 tokens" {
+    const t = table(true);
+    // the extrapolated end stays the plain frequency, the interpolated end is a quarter of it, the ramp between them is monotonic
+    const plain = table(false);
+    for (0..14) |i| try std.testing.expectApproxEqRel(plain[i], t[i], 1e-6);
+    for (22..half) |i| try std.testing.expectApproxEqRel(plain[i] / 4, t[i], 1e-6);
+    for (1..half) |i| try std.testing.expect(t[i] < t[i - 1]);
+    try std.testing.expectApproxEqRel(@as(f32, 1.138629436111989), t[half], 1e-6);
+    // the first words of the table replay.zig holds from transformers
+    const want = [_]f32{ 1.0, 0.6042963862419128, 0.36517414450645447, 0.22067339718341827, 0.1333521455526352, 0.08058421313762665, 0.04869675263762474, 0.02942727319896221, 0.017782794311642647 };
+    for (want, t[0..want.len]) |w, g| try std.testing.expectApproxEqRel(w, g, 1e-6);
+}
+
+test "the window's limits: plain to 262,144, YaRN past it up to 1,048,576" {
+    const prompt = @import("cuda_prompt.zig");
+    try std.testing.expect(!prompt.yarnFor(262144));
+    try std.testing.expect(prompt.yarnFor(262145));
+    try std.testing.expectEqual(@as(usize, 1048576), prompt.max_context);
+    try std.testing.expectEqual(@as(usize, 262144), prompt.capLimit(262144, 8));
+    try std.testing.expectEqual(@as(usize, 262144), prompt.capLimit(131072, 8));
+    try std.testing.expectEqual(@as(usize, 1000008), prompt.capLimit(1000000, 8));
+}
+
+test "a million tokens' fp8 caches on the sizes the recipe plans with" {
+    const prompt = @import("cuda_prompt.zig");
+    const n = prompt.seqBytesFor(.fp8, 1_000_000);
+    const per = @as(f64, @floatFromInt(n)) / 1_000_000;
+    try std.testing.expect(per > 16_000 and per < 17_888);
+}
